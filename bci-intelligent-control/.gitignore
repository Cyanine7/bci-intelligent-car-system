# Keil uVision build output
OBJ/
*.o
*.obj
*.crf
*.d
*.axf
*.map
*.lst
*.lnp
*.dep
*.sct
*.htm
*.htm.*
*.build_log.htm

# Firmware images generated by the build
/*.bin
/*.hex

# Keil per-user and debugger state
USER/*.uvoptx
USER/*.uvguix*
USER/DebugConfig/
USER/RTE/
USER/JLinkLog.txt

# Cloud-sync temporary files
.fang_cloud_tmp_dir/

# Common editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Native software-test fixtures (generated by MSVC)
tests/*.dll
tests/*.lib
tests/*.exp
tests/*.exe
tests/__pycache__/

# Keep development notes local; publish only the frozen dual-end protocol.
/docs/*
!/docs/PROJECT_V1协议.md
